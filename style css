@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Poppins:wght@300;400;500;600&display=swap');

:root{
    --cream:#FCF8F5;
    --white:#FFFFFF;
    --beige:#F2E8E2;
    --mocha:#8A6E63;
    --brown:#4E3F38;
    --pink:#D8B2BC;
    --shadow:0 15px 40px rgba(0,0,0,.08);
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:'Poppins',sans-serif;
    background:var(--cream);
    color:var(--brown);
}

a{
    text-decoration:none;
    color:inherit;
}

button{
    font-family:'Poppins',sans-serif;
} 
header{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    padding:40px;
    background:linear-gradient(135deg,#fffdfc,#f5ebe6);
}

.overlay{
    max-width:750px;
}

h1{
    font-family:'Cormorant Garamond',serif;
    font-size:90px;
    letter-spacing:6px;
    margin-bottom:20px;
}

.subtitle{
    font-size:18px;
    text-transform:uppercase;
    letter-spacing:3px;
    color:var(--mocha);
    margin-bottom:20px;
}

.description{
    font-size:18px;
    line-height:1.9;
    margin-bottom:40px;
}
.heroButtons{
    display:flex;
    justify-content:center;
    gap:15px;
    flex-wrap:wrap;
}

.mainBtn,
.secondaryBtn{
    padding:15px 35px;
    border-radius:50px;
    transition:.35s;
    font-weight:500;
}

.mainBtn{
    background:var(--mocha);
    color:white;
}

.secondaryBtn{
    background:white;
    color:var(--brown);
    box-shadow:var(--shadow);
}

.mainBtn:hover,
.secondaryBtn:hover{
    transform:translateY(-5px);
}
/* Search */

.searchSection{
    padding:60px 20px 20px;
    display:flex;
    justify-content:center;
}

#searchInput{
    width:700px;
    max-width:90%;
    padding:18px 25px;
    border:none;
    border-radius:50px;
    font-size:16px;
    background:white;
    box-shadow:0 10px 30px rgba(0,0,0,.08);
    outline:none;
}

/* Categories */

.categories{
    display:flex;
    justify-content:center;
    gap:15px;
    flex-wrap:wrap;
    padding:25px 20px 60px;
}

.categories button{
    border:none;
    background:white;
    padding:12px 28px;
    border-radius:40px;
    cursor:pointer;
    transition:.3s;
    box-shadow:0 10px 25px rgba(0,0,0,.08);
}

.categories button:hover{
    background:#8A6E63;
    color:white;
}

.categories .active{
    background:#8A6E63;
    color:white;
}
/* Products */

#shop{
    padding:40px 70px;
}

#shop h2{
    text-align:center;
    font-size:56px;
    font-family:'Cormorant Garamond',serif;
    margin-bottom:60px;
}

#productContainer{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
    gap:35px;
}
.card{
    background:white;
    border-radius:24px;
    overflow:hidden;
    box-shadow:0 12px 35px rgba(0,0,0,.08);
    transition:.35s;
}

.card:hover{
    transform:translateY(-10px);
}

.card img{
    width:100%;
    height:420px;
    object-fit:cover;
    display:block;
    transition:.4s;
}

.card:hover img{
    transform:scale(1.05);
}

.cardContent{
    padding:25px;
}

.cardContent h3{
    font-family:'Cormorant Garamond',serif;
    font-size:28px;
    margin-bottom:8px;
}

.code{
    color:#8A6E63;
    margin-bottom:10px;
}

.price{
    font-size:22px;
    font-weight:600;
    margin-bottom:20px;
}
.cardButtons{
    display:flex;
    gap:12px;
}

.cardButtons button{
    flex:1;
    padding:14px;
    border:none;
    border-radius:40px;
    background:#8A6E63;
    color:white;
    cursor:pointer;
    transition:.3s;
}

.cardButtons button:hover{
    background:#6f574e;
}
/* Shipping */

.shipping,
.faq{
    padding:90px 30px;
}

.shipping h2,
.faq h2{
    text-align:center;
    font-family:'Cormorant Garamond',serif;
    font-size:52px;
    margin-bottom:45px;
}

.shippingGrid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:30px;
    max-width:900px;
    margin:auto;
}

.shippingGrid div{
    background:white;
    padding:35px;
    border-radius:20px;
    text-align:center;
    box-shadow:0 12px 35px rgba(0,0,0,.08);
}
/* FAQ */

.faqItem{
    background:white;
    max-width:900px;
    margin:20px auto;
    padding:25px;
    border-radius:20px;
    box-shadow:0 12px 35px rgba(0,0,0,.08);
}

.faqItem h3{
    margin-bottom:10px;
    font-size:20px;
}

.faqItem p{
    color:#666;
    line-height:1.8;
}
/* Footer */

footer{
    background:#F5EDE8;
    padding:70px 20px;
    text-align:center;
}

footer h2{
    font-family:'Cormorant Garamond',serif;
    font-size:55px;
    margin-bottom:15px;
}

.footerLinks{
    display:flex;
    justify-content:center;
    gap:30px;
    margin:30px 0;
}

.footerLinks a{
    color:#4E3F38;
    font-weight:500;
}

.copyright{
    margin-top:25px;
    color:#777;
}
/* WhatsApp */

#whatsappButton{
    position:fixed;
    right:25px;
    bottom:25px;
    width:65px;
    height:65px;
    border:none;
    border-radius:50%;
    background:#25D366;
    color:white;
    font-size:30px;
    cursor:pointer;
    box-shadow:0 12px 35px rgba(0,0,0,.2);
    z-index:999;
}

/* Popup */

#productModal{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.55);
    justify-content:center;
    align-items:center;
    padding:20px;
    z-index:1000;
}

#modalContent{
    background:white;
    width:900px;
    max-width:95%;
    border-radius:25px;
    padding:35px;
    position:relative;
}

#closeModal{
    position:absolute;
    top:18px;
    right:25px;
    font-size:34px;
    cursor:pointer;
}
